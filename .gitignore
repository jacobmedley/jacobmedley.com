
/node_modules
prepros.config

# Next.js build artifacts
/.next
/out
tsconfig.tsbuildinfo

# OS metadata
.DS_Store
**/.DS_Store

# Machine-local Claude Code permission cache — tracked changes here don't
# belong in the repo history and shouldn't fire a deploy.
.claude/settings.local.json

# public/images is a local junction/symlink → ../images/ (machine-specific, not committed)
# On Windows: cmd /c mklink /J public\images images
# On macOS/Linux: ln -s ../images public/images
/public/images

# _archive/{images,components,node_modules} are local junctions created by
# scripts/parity/setup-legacy.mjs so the archived static site can resolve
# its own includes/assets when served on :4000 (machine-specific, not committed)
/_archive/images
/_archive/components
/_archive/node_modules

# Parity harness screenshots
/scripts/parity/shots

# Private, unscrubbed source data. Never commit. Repo is public.
/_data_case_studies
/_private

# Multi-session working-agreement lock file (machine-local, not committed)
.tree-lock
