{
  "name": "jacobmedley-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup-dev.mjs",
    "dev": "npm run setup && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "parity:setup-legacy": "node scripts/parity/setup-legacy.mjs",
    "parity:capture": "npm run parity:setup-legacy && node --experimental-strip-types scripts/parity/capture.mjs",
    "parity:capture:modals": "npm run parity:setup-legacy && node --experimental-strip-types scripts/parity/capture.mjs --modals",
    "parity:diff": "node scripts/parity/diff.mjs",
    "parity": "npm run parity:capture && npm run parity:capture:modals && npm run parity:diff"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "bootstrap": "^5.3.3",
    "clsx": "^2.1.1",
    "next": "^15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.15",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.4",
    "typescript": "^5"
  }
}
